# Copy to .env.local (git-ignored) or export as environment variables. Never commit real values.
# `neon init` writes the two DATABASE_URL lines for you.

# Neon PostgreSQL (profile: neon)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Alternatively give JDBC settings directly:
# DATABASE_URL=jdbc:postgresql://ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=...
# DATABASE_PASSWORD=...

# Machine credentials (use long random values, e.g. `openssl rand -hex 32`; at least 24 characters, and the two must
# differ, or the app refuses to start outside the demo profile). Prefer per-gateway keys from Administration → Edge
# gateways; BAS_EDGE_API_KEY is the shared fallback for existing edge nodes and can be left empty.
BAS_EDGE_API_KEY=change-me
BAS_AGENT_API_KEY=change-me

# Login accounts created on first start (existing accounts are never overwritten). Use at least 12 characters;
# "change-me" is refused. Further accounts are managed in Administration → Users.
BAS_ADMIN_PASSWORD=change-me
BAS_ENGINEER_PASSWORD=change-me
BAS_REVIEWER_PASSWORD=change-me
BAS_TECHNICIAN_PASSWORD=change-me
BAS_VIEWER_PASSWORD=change-me

# Optional
# BAS_SIMULATOR_ENABLED=true
# BAS_DEMO_SEED=true
